out/

# Local environment and secrets
.env
.env.local
.ngrok.runtime.yml

# Logs
*.log

# Runtime output. The top-level uploads/ and results/ folders are kept in the
# repo (empty) so a fresh clone owns them; if Docker has to create these bind
# mounts itself they are root-owned and the container cannot write to them.
**/uploads/*
**/results/*
!/uploads/.gitkeep
!/results/.gitkeep
afm-backend/uploads/
afm-backend/results/
afm-backend/segmentation_output/
afm-backend/voronoi_outputs/
afm-backend/colorwheel_output/
afm-backend/colorwheel_temp/
afm-backend/afm_runtime/voronoi_outputs/

# Local research/figure tooling, not part of the app
figure_scripts/
non-ess/

